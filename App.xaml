<!--
    OnExplicitShutdown: with the default OnLastWindowClose, whichever window happens to be open
    when the loading dialog is the only one left (e.g. during a roblox-player: launch, before
    MainWindow exists) can trigger app shutdown as a side effect of that window closing. Explicit
    shutdown means Application.Current.Shutdown() is the only thing that ever exits the app.
-->
<Application x:Class="Lingstrap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:Lingstrap.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Custom dark palette to match the app icon (#A778FF violet). Defined directly here
                (not inside the merged dictionaries above) so they survive any theme dictionary
                swap ApplicationThemeManager performs at runtime - a ResourceDictionary's own keys
                always take priority over same-named keys from its MergedDictionaries.
            -->
            <Color x:Key="ApplicationBackgroundColor">#FF16171F</Color>
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

            <Color x:Key="CardBackgroundFillColorDefault">#FF262834</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />

            <Color x:Key="ControlStrokeColorDefault">#1FFFFFFF</Color>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />

            <!--
                WPF-UI's dark default for this one is #19000000 - BLACK at 10% - which is what both
                the group outlines and every hairline between settings were being drawn in. Black on
                a #16171F ground lands about two percent away from the background, so the lines were
                effectively invisible; on a dark theme a separator has to be lighter than what it
                sits on, not darker. Overridden here (Color *and* Brush, like the palette above) so a
                runtime theme swap can't put WPF-UI's black one back.
            -->
            <Color x:Key="CardStrokeColorDefault">#2EFFFFFF</Color>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

            <!--
                The hairlines between rows are deliberately a step softer than the outline around the
                group. Drawn at the same weight, a group stops reading as one surface and turns into a
                stack of equally-boxed bars - the outline has to stay the strongest line in the
                picture for the rows inside it to read as belonging together.
            -->
            <Color x:Key="SettingRowDividerColor">#1FFFFFFF</Color>
            <SolidColorBrush x:Key="SettingRowDividerBrush" Color="{StaticResource SettingRowDividerColor}" />

            <Color x:Key="TextFillColorPrimary">#FFF5F6FA</Color>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

            <Color x:Key="TextFillColorSecondary">#FFA8AFBE</Color>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!--
                    A ScrollViewer with only vertical scrolling enabled does not constrain content
                    to the viewport width - "Disabled" for the horizontal axis means "give content
                    as much width as it wants," not "fit to the visible area." That leaves two
                    problems for wrapping text: (1) without MaxWidth, TextBlock's natural desired
                    width is the whole sentence unwrapped, so it never wraps; (2) even with MaxWidth
                    capping it correctly, Stretch-aligned content that's narrower than the (huge)
                    available space centers within it by default, so a properly wrapped block can
                    still drift far enough right to clip at the window edge. Both are fixed here.
                -->
                <Setter Property="MaxWidth" Value="600" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>

            <Style x:Key="HeaderIcon" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="600" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- A small all-caps caption sitting directly above the thing it names, for pages laid out
                 as labelled panels rather than a list of cards (SectionHeader is the heavier, more
                 spaced-out divider used between groups of cards). -->
            <Style x:Key="SectionCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="2,0,0,7" />
            </Style>

            <!-- One outline around a whole group of SettingRows, which are divided from each other by
                 hairlines inside it. Deliberately unfilled: a fill per setting turns a page into a
                 patchwork of separate blocks instead of one surface. -->
            <Style x:Key="SettingsGroup" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="0,0,0,22" />
            </Style>

            <Style TargetType="{x:Type v:SettingRow}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type v:SettingRow}">
                            <Border x:Name="Divider" BorderThickness="0,0,0,1" Padding="16,13,16,13"
                                    BorderBrush="{DynamicResource SettingRowDividerBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="Description" Text="{TemplateBinding Description}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="Description" Value="">
                                    <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="ShowDivider" Value="False">
                                    <Setter TargetName="Divider" Property="BorderThickness" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Slider, retemplated for one reason: the stock track ran past where the thumb could
                ever reach, so at Minimum and Maximum a stub of bare track stayed poking out beyond
                it. Here the track Border spans the control's whole width while WPF's Track lays the
                thumb's travel out inset by exactly half a thumb at each end - so at either extreme
                the thumb's outer edge lands on the track's outer edge and covers the rounded cap
                completely. That relationship is what makes the ends look finished, so the thumb's
                20px and the track's 4px/2px radius have to move together if either changes.

                Horizontal only, which is all this app uses; a vertical Slider would need its own.
            -->
            <Style x:Key="SliderRepeatBase" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <!-- Transparent, not null: a null Background gets no hit-testing, which
                                 would stop click-on-the-track from moving the thumb. -->
                            <Border Background="Transparent" Height="20" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderFillRepeat" TargetType="RepeatButton" BasedOn="{StaticResource SliderRepeatBase}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="20">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderThumbStyle" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse x:Name="Knob" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Slider}">
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid x:Name="Root" Height="20" Background="Transparent">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Style="{StaticResource SliderFillRepeat}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SliderThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Style="{StaticResource SliderRepeatBase}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

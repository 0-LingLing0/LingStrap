<Page x:Class="Lingstrap.Views.FastFlagsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:Lingstrap.Views"
      Title="FastFlags">
    <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="Flag24" Style="{StaticResource HeaderIcon}" />
                    <TextBlock Text="FastFlags" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}"
                           Text="Named controls for the flags people actually touch. Each has its own on/off - off means the flag isn't written at all." />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Open editor" Icon="{ui:SymbolIcon Code24}" Click="OpenFastFlagEditor_Click"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="RENDER QUALITY" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Render quality" Description="Overrides Roblox's own quality slider, 1 to 21.">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="RenderQualityToggle" Checked="RenderQualityToggle_Changed" Unchecked="RenderQualityToggle_Changed" Margin="0,0,14,0" />
                        <Slider x:Name="RenderQualitySlider" Width="150" Minimum="1" Maximum="21" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1"
                                ValueChanged="RenderQualitySlider_ValueChanged"
                                PreviewMouseUp="RenderQualitySlider_MouseUp" LostKeyboardFocus="RenderQualitySlider_LostFocus" />
                        <ui:NumberBox x:Name="RenderQualityBox" Width="64" Margin="10,0,0,0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                      LostKeyboardFocus="RenderQualityBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Texture quality" Description="0 is lowest, 3 is highest.">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="TextureQualityToggle" Checked="TextureQualityToggle_Changed" Unchecked="TextureQualityToggle_Changed" Margin="0,0,14,0" />
                        <ComboBox x:Name="TextureQualityCombo" Width="110" SelectionChanged="TextureQualityCombo_SelectionChanged">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                        </ComboBox>
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Anti-aliasing" Description="MSAA sample count. 0 turns it off.">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="AntiAliasingToggle" Checked="AntiAliasingToggle_Changed" Unchecked="AntiAliasingToggle_Changed" Margin="0,0,14,0" />
                        <ComboBox x:Name="AntiAliasingCombo" Width="110" SelectionChanged="AntiAliasingCombo_SelectionChanged">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="4" />
                        </ComboBox>
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Renderer" Description="Exactly one of these can be active. Not part of any preset.">
                    <ComboBox x:Name="RendererCombo" Width="140" SelectionChanged="RendererCombo_SelectionChanged">
                        <ComboBoxItem Content="D3D11" />
                        <ComboBoxItem Content="Vulkan" />
                        <ComboBoxItem Content="OpenGL" />
                    </ComboBox>
                </v:SettingRow>

                <v:SettingRow Title="Low-poly meshes" ShowDivider="False"
                              Description="Distances at which CSG parts drop to a lower level of detail.">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="LowPolyToggle" Checked="LowPolyToggle_Changed" Unchecked="LowPolyToggle_Changed" Margin="0,0,14,0" />
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Base" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:NumberBox x:Name="LodBaseBox" Width="76" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="L1-2" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:NumberBox x:Name="Lod12Box" Width="76" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="L2-3" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:NumberBox x:Name="Lod23Box" Width="76" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="L3-4" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:NumberBox x:Name="Lod34Box" Width="76" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                        </StackPanel>
                    </StackPanel>
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="WORLD" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Grass distance - minimum">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="GrassMinToggle" Checked="GrassMinToggle_Changed" Unchecked="GrassMinToggle_Changed" Margin="0,0,14,0" />
                        <ui:NumberBox x:Name="GrassMinBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMinBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Grass distance - maximum">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="GrassMaxToggle" Checked="GrassMaxToggle_Changed" Unchecked="GrassMaxToggle_Changed" Margin="0,0,14,0" />
                        <ui:NumberBox x:Name="GrassMaxBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMaxBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Grass movement">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch x:Name="GrassMovementToggle" Checked="GrassMovementToggle_Changed" Unchecked="GrassMovementToggle_Changed" Margin="0,0,14,0" />
                        <ui:NumberBox x:Name="GrassMovementBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMovementBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Freeze voxel lighting">
                    <ui:ToggleSwitch x:Name="FreezeVoxelToggle" Checked="FreezeVoxelToggle_Changed" Unchecked="FreezeVoxelToggle_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Gray sky" ShowDivider="False">
                    <ui:ToggleSwitch x:Name="SkyGrayToggle" Checked="SkyGrayToggle_Changed" Unchecked="SkyGrayToggle_Changed" />
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="WINDOW" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Disable DPI scaling">
                    <ui:ToggleSwitch x:Name="DisableDpiToggle" Checked="DisableDpiToggle_Changed" Unchecked="DisableDpiToggle_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Alt+Enter fullscreen" ShowDivider="False">
                    <ui:ToggleSwitch x:Name="AltEnterToggle" Checked="AltEnterToggle_Changed" Unchecked="AltEnterToggle_Changed" />
                </v:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

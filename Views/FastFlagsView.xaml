<Page x:Class="Lingstrap.Views.FastFlagsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="FastFlags">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="Flag24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="FastFlags" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" MaxWidth="700"
                   Text="Named controls for the flags people actually touch. Every control has its own on/off - off means the flag isn't written at all." />

        <ui:CardAction Margin="0,0,0,20" Click="OpenFastFlagEditor_Click">
            <ui:CardAction.Icon>
                <ui:SymbolIcon Symbol="Code24" />
            </ui:CardAction.Icon>
            <StackPanel>
                <TextBlock Text="FastFlag Editor" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="Raw, searchable access to every flag - including ones without a control below."
                           FontSize="12" Opacity="0.7" Margin="0,3,0,0" />
            </StackPanel>
        </ui:CardAction>

        <TextBlock Text="Render quality" Style="{StaticResource SectionHeader}" Margin="0,4,0,10" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Render quality" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="380"
                               Text="Overrides Roblox's own quality slider, 1 to 21." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="RenderQualityToggle" Checked="RenderQualityToggle_Changed" Unchecked="RenderQualityToggle_Changed" Margin="0,0,14,0" />
                <Slider x:Name="RenderQualitySlider" Width="150" Minimum="1" Maximum="21" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1"
                        ValueChanged="RenderQualitySlider_ValueChanged"
                        PreviewMouseUp="RenderQualitySlider_MouseUp" LostKeyboardFocus="RenderQualitySlider_LostFocus" />
                <ui:NumberBox x:Name="RenderQualityBox" Width="64" Margin="10,0,0,0"
                              SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                              LostKeyboardFocus="RenderQualityBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Texture quality" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="380"
                               Text="0 is lowest, 3 is highest." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="TextureQualityToggle" Checked="TextureQualityToggle_Changed" Unchecked="TextureQualityToggle_Changed" Margin="0,0,14,0" />
                <ComboBox x:Name="TextureQualityCombo" Width="110" SelectionChanged="TextureQualityCombo_SelectionChanged">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Anti-aliasing" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="380"
                               Text="MSAA sample count. 0 turns it off." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="AntiAliasingToggle" Checked="AntiAliasingToggle_Changed" Unchecked="AntiAliasingToggle_Changed" Margin="0,0,14,0" />
                <ComboBox x:Name="AntiAliasingCombo" Width="110" SelectionChanged="AntiAliasingCombo_SelectionChanged">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="4" />
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Renderer" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="300"
                               Text="Exactly one of these can be active. Not part of any preset." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="RendererCombo" Width="140" SelectionChanged="RendererCombo_SelectionChanged">
                <ComboBoxItem Content="D3D11" />
                <ComboBoxItem Content="Vulkan" />
                <ComboBoxItem Content="OpenGL" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Low-poly meshes" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="380"
                               Text="Distances at which CSG parts drop to a lower level of detail." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="LowPolyToggle" Checked="LowPolyToggle_Changed" Unchecked="LowPolyToggle_Changed" Margin="0,0,14,0" />
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Base" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                    <ui:NumberBox x:Name="LodBaseBox" Width="80" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="L1-2" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                    <ui:NumberBox x:Name="Lod12Box" Width="80" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="L2-3" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                    <ui:NumberBox x:Name="Lod23Box" Width="80" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="L3-4" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                    <ui:NumberBox x:Name="Lod34Box" Width="80" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" LostKeyboardFocus="LodBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                </StackPanel>
            </StackPanel>
        </ui:CardControl>

        <TextBlock Text="World" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Grass distance - minimum" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="GrassMinToggle" Checked="GrassMinToggle_Changed" Unchecked="GrassMinToggle_Changed" Margin="0,0,14,0" />
                <ui:NumberBox x:Name="GrassMinBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMinBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Grass distance - maximum" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="GrassMaxToggle" Checked="GrassMaxToggle_Changed" Unchecked="GrassMaxToggle_Changed" Margin="0,0,14,0" />
                <ui:NumberBox x:Name="GrassMaxBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMaxBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Grass movement" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="GrassMovementToggle" Checked="GrassMovementToggle_Changed" Unchecked="GrassMovementToggle_Changed" Margin="0,0,14,0" />
                <ui:NumberBox x:Name="GrassMovementBox" Width="110" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" LostKeyboardFocus="GrassMovementBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Freeze voxel lighting" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="FreezeVoxelToggle" Checked="FreezeVoxelToggle_Changed" Unchecked="FreezeVoxelToggle_Changed" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Gray sky" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="SkyGrayToggle" Checked="SkyGrayToggle_Changed" Unchecked="SkyGrayToggle_Changed" />
        </ui:CardControl>

        <TextBlock Text="Window" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Disable DPI scaling" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="DisableDpiToggle" Checked="DisableDpiToggle_Changed" Unchecked="DisableDpiToggle_Changed" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <TextBlock Text="Alt+Enter fullscreen" Style="{StaticResource Body}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AltEnterToggle" Checked="AltEnterToggle_Changed" Unchecked="AltEnterToggle_Changed" />
        </ui:CardControl>
    </StackPanel>
</Page>

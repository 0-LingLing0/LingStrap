<UserControl x:Class="Lingstrap.Views.GbsFieldRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:CardControl x:Name="Card" Margin="0,0,0,8">
        <ui:CardControl.Header>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="LabelText" FontWeight="SemiBold" FontSize="13" MaxWidth="380" TextWrapping="Wrap" HorizontalAlignment="Left" />
                <TextBlock x:Name="DescText" Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="380" />
                <TextBlock x:Name="WarningText" Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="380"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ui:CardControl.Header>

        <StackPanel Orientation="Horizontal">
            <ContentControl x:Name="ValueHost" VerticalAlignment="Center" />
            <ui:Button x:Name="ResetButton" Icon="{ui:SymbolIcon ArrowReset24}" Margin="10,0,0,0"
                       ToolTip="Reset this value from the backup" Click="Reset_Click" />
        </StackPanel>
    </ui:CardControl>
</UserControl>

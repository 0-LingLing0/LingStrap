<UserControl x:Class="Lingstrap.Views.GbsFieldRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Matches SettingRow: a hairline-divided row inside one group border, not a card of its own.
         This page can list hundreds of these, and a card each made it a wall of separate blocks. -->
    <Border BorderThickness="0,0,0,1" Padding="16,11,16,11"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock x:Name="LabelText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="DescText" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="ValueHost" VerticalAlignment="Center" />
                <ui:Button x:Name="ResetButton" Icon="{ui:SymbolIcon ArrowReset24}" Margin="10,0,0,0"
                           ToolTip="Reset this value from the backup" Click="Reset_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

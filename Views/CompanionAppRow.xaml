<UserControl x:Class="Lingstrap.Views.CompanionAppRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,8">
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:ImageIcon x:Name="AppIcon" Width="28" Height="28" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="PathText" Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="380"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="EnabledToggle" Margin="0,0,10,0" Checked="EnabledToggle_Changed" Unchecked="EnabledToggle_Changed" />
                <ui:Button x:Name="UpButton" Icon="{ui:SymbolIcon ArrowUp24}" Margin="0,0,4,0" Click="Up_Click" ToolTip="Move up" />
                <ui:Button x:Name="DownButton" Icon="{ui:SymbolIcon ArrowDown24}" Margin="0,0,10,0" Click="Down_Click" ToolTip="Move down" />
                <ui:Button x:Name="EditButton" Content="Edit" Margin="0,0,6,0" Click="Edit_Click" />
                <ui:Button Content="Delete" Click="Delete_Click" />
            </StackPanel>
        </ui:CardControl>

        <Border x:Name="EditPanel" Visibility="Collapsed" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="0,0,6,6" Margin="0,-6,0,0" Padding="16,14,16,14">
            <StackPanel>
                <TextBlock Text="Display name" Style="{StaticResource Sub}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="NameBox" Margin="0,0,0,10" TextChanged="Field_Changed" />

                <TextBlock Text="Launch arguments" Style="{StaticResource Sub}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="ArgumentsBox" Margin="0,0,0,10" PlaceholderText="(none)" TextChanged="Field_Changed" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Startup delay (seconds)" Style="{StaticResource Sub}" Margin="0,0,0,4" />
                        <ui:NumberBox x:Name="DelayBox" Width="110" Minimum="0" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" ValueChanged="Field_Changed" />
                    </StackPanel>
                </StackPanel>

                <ui:CardControl Margin="0,0,0,6">
                    <ui:CardControl.Header>
                        <TextBlock Text="Run as administrator" Style="{StaticResource Body}" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AdminToggle" Checked="Field_Changed" Unchecked="Field_Changed" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,10">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Don't auto-close this one" Style="{StaticResource Body}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="380"
                                       Text="Keeps it running after Roblox closes, even though it launches with it." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="DontAutoCloseToggle" Checked="Field_Changed" Unchecked="Field_Changed" />
                </ui:CardControl>

                <ui:Button Content="Done" HorizontalAlignment="Left" Click="Done_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

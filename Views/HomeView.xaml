<Page x:Class="Lingstrap.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Home">
    <StackPanel Margin="28,24,28,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Home24" Style="{StaticResource HeaderIcon}" />
                <TextBlock Text="Home" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}"
                       Text="Launch Roblox through Lingstrap with your settings applied." />

            <Border CornerRadius="14" Margin="0,4,0,20" HorizontalAlignment="Left" MinWidth="480">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="12" Opacity="0.45" Direction="270" />
                </Border.Effect>
                <Border CornerRadius="14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="HeroGradientStart" Offset="0" />
                            <GradientStop x:Name="HeroGradientEnd" Offset="0.55" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Soft accent glow in the corner, echoing the loading screen's icon halo. -->
                        <Ellipse x:Name="HeroGlow" Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-90,-90,0" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="50" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <StackPanel Margin="28,26">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon x:Name="PresetIcon" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="PresetText" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="PresetDesc" Style="{StaticResource Sub}" Margin="0,2,0,22" MaxWidth="480" />

                            <ui:Button x:Name="LaunchButton" Content="Launch Roblox"
                                       Appearance="Primary" FontSize="17" Padding="32,15"
                                       HorizontalAlignment="Left"
                                       Icon="{ui:SymbolIcon PlayCircle24}"
                                       Click="LaunchButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Loose icon+text lines under a card that only held a button read as leftovers below the
                 real content. The same facts as labelled rows with their values on the right fill the
                 page properly and match every other page's grouping. -->
            <TextBlock Text="AT A GLANCE" Style="{StaticResource SectionCaption}" />
            <Border Style="{StaticResource SettingsGroup}" MinWidth="480" HorizontalAlignment="Left">
                <StackPanel x:Name="StatusRowsPanel" />
            </Border>
    </StackPanel>
</Page>

<Page x:Class="Lingstrap.Views.BehaviourView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:Lingstrap.Views"
      Title="Behaviour">
    <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="Behaviour" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="How Lingstrap itself behaves around the client." Margin="0,0,0,22" />

        <TextBlock Text="LAUNCHING" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Show loading screen" Description="Off launches silently with no window at all.">
                    <ui:ToggleSwitch x:Name="ChkLoadingScreen" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Close Lingstrap once Roblox starts">
                    <ui:ToggleSwitch x:Name="ChkCloseOnLaunch" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Reopen Lingstrap once Roblox closes"
                              Description="Brings Lingstrap back once you're done playing, instead of leaving nothing running.">
                    <ui:ToggleSwitch x:Name="ChkReopenOnClose" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Close the Roblox crash handler">
                    <ui:ToggleSwitch x:Name="ChkCrashHandler" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Process priority"
                              Description="Set by whichever preset is active. Changing it switches you to Custom.">
                    <ComboBox x:Name="PriorityCombo" Width="140" SelectionChanged="PriorityCombo_SelectionChanged">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Above Normal" />
                        <ComboBoxItem Content="High" />
                    </ComboBox>
                </v:SettingRow>

                <v:SettingRow Title="Allow multi-instance launching" ShowDivider="False"
                              Description="Holds Roblox's singleton mutex so more than one client can run. Roblox actively works against this, so it can break at any update.">
                    <ui:ToggleSwitch x:Name="ChkMulti" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Force dedicated GPU"
                              Description="Tells Windows to run Roblox on your discrete GPU instead of the integrated one, on laptops with both.">
                    <ui:ToggleSwitch x:Name="ChkDedicatedGpu" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Pin clients to separate cores"
                              Description="Only matters with multi-instance. A single client always gets every core - never pinned.">
                    <ui:ToggleSwitch x:Name="ChkPinCores" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <Border x:Name="CpuPinningCard" Visibility="Collapsed" Padding="16,13,16,13"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Current pinning" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel x:Name="CpuAssignmentsPanel" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <v:SettingRow Title="Network optimization" ShowDivider="False"
                              Description="Lowers in-game ping: disables adapter power saving, lifts Windows' cap on packet processing, turns off Energy-Efficient Ethernet and Interrupt Moderation where the driver exposes them, frees the bandwidth QoS reserves, and stops Windows Update sharing chunks with other PCs. System-wide and needs administrator rights. Every value is backed up first, so Restore puts it all back exactly.">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Optimize" Click="OptimizeNetwork_Click" />
                        <Button x:Name="RestoreNetworkButton" Content="Restore" Margin="8,0,0,0" Click="RestoreNetwork_Click" />
                    </StackPanel>
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="WINDOW" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel Margin="16,14,16,16">
                <TextBlock Text="Preferred launch monitor" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,12" MaxWidth="460" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Moves Roblox onto this monitor as soon as its window appears. Only matters if you have more than one - click one to pick it." />
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" HorizontalAlignment="Left">
                    <Canvas x:Name="MonitorMapCanvas" />
                </Border>
                <Button Content="Use whichever monitor Windows opens it on" Margin="0,12,0,0"
                        HorizontalAlignment="Left" Click="UseDefaultMonitor_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="SERVER INFO AND PRESENCE" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Show server info on join"
                              Description="Master switch - captures where the server is when you join. Off stops the banner below too.">
                    <ui:ToggleSwitch x:Name="ChkServerLocation" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Show an overlay banner on join">
                    <ui:ToggleSwitch x:Name="ChkNotification" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow x:Name="BannerDurationCard" Title="How long the banner stays open">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="BannerDurationSlider" Width="150" Minimum="1" Maximum="10" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1"
                                ValueChanged="BannerDurationSlider_ValueChanged"
                                PreviewMouseUp="BannerDurationSlider_MouseUp" LostKeyboardFocus="BannerDurationSlider_LostFocus" />
                        <ui:NumberBox x:Name="BannerDurationBox" Width="64" Margin="10,0,6,0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                      LostKeyboardFocus="BannerDurationBox_LostFocus" PreviewKeyDown="NumberBox_EnterCommits" />
                        <TextBlock Text="seconds" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </v:SettingRow>

                <v:SettingRow Title="Discord Rich Presence" ShowDivider="False"
                              Description="Shows &quot;Playing Lingstrap&quot; on your Discord profile instead of Roblox's own status.">
                    <ui:ToggleSwitch x:Name="ChkDiscord" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Show FPS while Roblox is running"
                              Description="Measures the real frame rate from outside the process, the same way tools like RTSS do. That needs administrator rights, so turning it on asks you to approve once - never again after that.">
                    <ui:ToggleSwitch x:Name="ChkFpsOverlay" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow Title="Overlay position" ShowDivider="False">
                    <ComboBox x:Name="FpsPositionCombo" Width="140" SelectionChanged="FpsPositionCombo_SelectionChanged">
                        <ComboBoxItem Content="Top left" />
                        <ComboBoxItem Content="Top right" />
                        <ComboBoxItem Content="Bottom left" />
                        <ComboBoxItem Content="Bottom right" />
                    </ComboBox>
                </v:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

<Page x:Class="Lingstrap.Views.AboutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:Lingstrap.Views"
      Title="About">
    <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="Info24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="About" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="Lingstrap - a Roblox bootstrapper." Margin="0,0,0,22" />

        <Border Style="{StaticResource SettingsGroup}" MinWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <v:SettingRow x:Name="VersionRow" Title="Version" />

                <v:SettingRow Title="Logs" Description="One file per run, including the background watcher processes.">
                    <ui:Button Content="Open folder" Click="OpenLogs_Click" />
                </v:SettingRow>

                <v:SettingRow Title="Source" ShowDivider="False" Description="Every line of this project was written by Claude.">
                    <ui:Button Content="View on GitHub" Click="OpenGitHub_Click" />
                </v:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}" MinWidth="560" HorizontalAlignment="Left">
            <v:SettingRow Title="Force a clean reinstall" ShowDivider="False"
                          Description="Deletes the whole current Roblox install so the next launch downloads it fresh. Worth trying if Roblox crashes on startup or behaves oddly for no obvious reason - it rules out a corrupted install.">
                <ui:Button Content="Delete install" Click="ForceCleanReinstall_Click" />
            </v:SettingRow>
        </Border>

        <TextBlock Style="{StaticResource Sub}" MaxWidth="560" HorizontalAlignment="Left" Margin="2,0,0,0"
                   Text="Not affiliated with Roblox Corporation. Modifying your own client is your own risk - especially multi-instance, which Roblox does not support." />
    </StackPanel>
</Page>

<Window x:Class="Lingstrap.Views.BootstrapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lingstrap" Width="580" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <!-- Most colours here are fixed literals matched to the app's dark palette - only the progress
         bar fill, stripes, glows and accent bar (built in code-behind) follow the chosen accent. -->
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFA8AFBE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Width="30" Height="30" CornerRadius="15">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="20" MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect x:Name="AmbientShadow" Color="Black" BlurRadius="36" ShadowDepth="10" Opacity="0.5" Direction="270" />
        </Border.Effect>
        <!-- ClipToBounds only clips to the rectangular layout box, not the rounded shape CornerRadius
             paints - without this explicit rounded clip, content (the animated diagonal stripes)
             pokes past the rounded background right in the corners, where the background's own
             rounded fill has already curved inward but a plain rectangular clip hasn't. -->
        <Border.Clip>
            <RectangleGeometry Rect="0,0,580,220" RadiusX="20" RadiusY="20" />
        </Border.Clip>

        <Grid>
            <!-- Base vertical gradient -->
            <Border CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF2A2C3A" Offset="0" />
                        <GradientStop Color="#FF15161D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Two diagonal stripe layers at different speeds/opacities for a subtle parallax feel,
                 both accent-tinted and built in code-behind alongside the icon glow. -->
            <Border x:Name="StripesHostBack" CornerRadius="20" ClipToBounds="True" />
            <Border x:Name="StripesHost" CornerRadius="20" ClipToBounds="True" />

            <!-- 1px border -->
            <Border CornerRadius="20" BorderThickness="1" BorderBrush="#2EFFFFFF" />

            <!-- Soft pulsing halo behind the icon, tinted to the current accent colour. -->
            <Ellipse x:Name="IconGlow" Width="116" Height="116" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="12,40,0,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="28" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Content -->
            <Image x:Name="LogoImage" Width="76" Height="76"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,60,0,0"
                   RenderTransformOrigin="0.5,0.5" Stretch="Uniform">
                <Image.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.4" Direction="270" />
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>

            <Border x:Name="TitleAccentBar" Width="4" Height="30" CornerRadius="2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="128,60,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="142,58,0,0">
                <TextBlock Text="Lingstrap" FontSize="26" FontWeight="SemiBold" Foreground="#FFF5F6FA" VerticalAlignment="Bottom" />
                <TextBlock Text="v0.1.0" FontSize="12" Foreground="#FFA8AFBE" VerticalAlignment="Bottom" Margin="10,0,0,4" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="Checking for updates" FontSize="14" Foreground="#FFA8AFBE"
                       TextWrapping="Wrap" MaxWidth="380"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="142,96,0,0" />

            <TextBlock x:Name="PercentText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#FFA8AFBE"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,98,40,0" />

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="12" Margin="142,132,40,0">
                <Border CornerRadius="6" Background="#29FFFFFF" />
                <Border x:Name="ProgressClip" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left">
                    <Border x:Name="ProgressFill" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Left" Width="0" ClipToBounds="True">
                        <!-- Decorative glossy sweep - purely visual, independent of the fill/slide
                             animations above so it never fights StartIndeterminate's own RenderTransform. -->
                        <Border Width="50" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShimmerTransform" X="-50" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#55FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </Border>
            </Grid>

            <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                    Click="CloseButton_Click" />

            <ui:Button x:Name="CopyLogButton" Content="Copy log" Visibility="Collapsed"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="142,156,0,0"
                       Click="CopyLogButton_Click" />
        </Grid>
    </Border>
</Window>

<Page x:Class="Lingstrap.Views.UpdatesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Updates">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="ArrowDownload24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="Updates" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="Check for and install new Lingstrap versions." />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Check for updates" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="450" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button x:Name="CheckUpdateButton" Content="Check now" Click="CheckForUpdates_Click" VerticalAlignment="Center" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Update behavior" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="450"
                               Text="What Lingstrap does with a new release it finds each time it starts." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="UpdateModeCombo" Width="180" SelectionChanged="UpdateModeCombo_SelectionChanged">
                <ComboBoxItem Content="Off - never check" />
                <ComboBoxItem Content="Notify me" />
                <ComboBoxItem Content="Install automatically" />
            </ComboBox>
        </ui:CardControl>
    </StackPanel>
</Page>

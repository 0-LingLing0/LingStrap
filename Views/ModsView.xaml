<Page x:Class="Lingstrap.Views.ModsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:Lingstrap.Views"
      Title="Mods and Cursors">
    <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="Cursor24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="Mods and Cursors" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="Replace client files - cursors, textures, fonts, sounds." Margin="0,0,0,22" />

        <TextBlock Text="MODS FOLDER" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <v:SettingRow Title="Enable mods"
                              Description="Copies everything in the Mods folder over the Roblox install at launch, and restores the originals when this is off.">
                    <ui:ToggleSwitch x:Name="ChkModsEnabled" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                </v:SettingRow>

                <v:SettingRow x:Name="ModsFolderRow" Title="Folder" ShowDivider="False">
                    <ui:Button Content="Open folder" Click="OpenMods_Click" />
                </v:SettingRow>
            </StackPanel>
        </Border>

        <!-- Cursors are shown open rather than behind an expander: they're the reason most people come
             to this page, and the slots are drop targets - worth seeing without a click first. -->
        <TextBlock Text="CURSORS" Style="{StaticResource SectionCaption}" />
        <Border Style="{StaticResource SettingsGroup}">
            <StackPanel Margin="16,14,16,16">
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" MaxWidth="460" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Drop an image on a slot, or click it to browse. Each one is resized to the size Roblox expects." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" x:Name="CursorSlotsPanel" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

<Page x:Class="Lingstrap.Views.ModsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Mods and Cursors">
    <StackPanel Margin="28,24,28,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Cursor24" Style="{StaticResource HeaderIcon}" />
                <TextBlock Text="Mods and Cursors" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" Text="Replace client files - cursors, textures, fonts, sounds." />

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Enable mods" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="400"
                                   Text="Copies everything in the Mods folder over the Roblox install at launch, and restores the originals when this is off." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ChkModsEnabled" Checked="Setting_Changed" Unchecked="Setting_Changed" />
            </ui:CardControl>

            <ui:CardExpander IsExpanded="False" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Cursor24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Cursors" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                   Text="Use your own mouse and shiftlock cursor." />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" x:Name="CursorSlotsPanel" />
            </ui:CardExpander>

            <ui:CardControl>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Mods folder" />
                        <TextBlock x:Name="ModsPathText" Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="500" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Open Mods folder" Click="OpenMods_Click" VerticalAlignment="Center" />
            </ui:CardControl>
    </StackPanel>
</Page>

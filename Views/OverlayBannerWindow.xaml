<Window x:Class="Lingstrap.Views.OverlayBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Width="300" SizeToContent="Height"
        Opacity="0">
    <!-- Colours here are intentionally fixed literals matched to the app icon, not theme
         resources - this banner's look is specified, so it won't track theme/accent changes. -->
    <Border CornerRadius="10" Background="#D916171F" BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#A778FF" CornerRadius="10,0,0,10" />

            <StackPanel x:Name="ContentPanel" Grid.Column="1" Orientation="Vertical"
                        VerticalAlignment="Center" Margin="14,10,14,10" ClipToBounds="True" />
        </Grid>
    </Border>
</Window>

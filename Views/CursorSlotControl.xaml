<UserControl x:Class="Lingstrap.Views.CursorSlotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Every TextBlock here sets its own Foreground. They used to sit inside a CardExpander and
         inherit one from its template; on a plain panel there's nothing to inherit from and WPF's
         default for an unstyled TextBlock is black, which is invisible on the dark theme. -->
    <StackPanel Width="130">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />

        <Grid Width="120" Height="120" AllowDrop="True"
              DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" DragOver="DropZone_DragEnter"
              Drop="DropZone_Drop" MouseLeftButtonUp="DropZone_Click"
              MouseEnter="DropZone_MouseEnter" MouseLeave="DropZone_MouseLeave" Cursor="Hand">

            <Border x:Name="SolidBorder" CornerRadius="6" Opacity="0.85"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Visibility="Collapsed" />

            <Rectangle x:Name="DashedBorder" RadiusX="6" RadiusY="6" Fill="Transparent" Opacity="0.7"
                       StrokeThickness="2" StrokeDashArray="4 3"
                       Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />

            <TextBlock x:Name="HintText" Text="Drop an image here" TextWrapping="Wrap"
                       TextAlignment="Center" FontSize="11" Margin="10"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="FileNameText" FontSize="11" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120" Visibility="Collapsed" />

        <StackPanel x:Name="ScalePanel" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="Size" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- Stretch so the slider fills this column: the app's Slider template (App.xaml) draws
                 its track across the control's full width, so a slider left at its own default
                 alignment would size itself to its content and leave the track short of the column
                 it's supposed to span. -->
            <!-- This used to claim WPF-UI's stock template already made the thumb cover the track's
                 ends. It didn't - both extremes left a stub of bare track showing - which is why
                 App.xaml retemplates Slider rather than relying on the stock one. -->
            <Slider x:Name="ScaleSlider" Minimum="25" Maximum="200" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,0"
                    HorizontalAlignment="Stretch"
                    ValueChanged="ScaleSlider_ValueChanged" />
            <TextBlock x:Name="ScaleSizeText" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:Button x:Name="ClearButton" Content="Clear" HorizontalAlignment="Center" Margin="0,8,0,0"
                   IsEnabled="False" Click="Clear_Click" />
    </StackPanel>
</UserControl>

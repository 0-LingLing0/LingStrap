<Page x:Class="Lingstrap.Views.AppearanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Appearance">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="Appearance" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="Pick an accent color for the app - a theme color, or any color you like." />

        <Border x:Name="PickerHost" Margin="0,20,0,4" />

        <ui:CardControl Margin="0,20,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Light theme" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="450"
                               Text="Switches from the default dark look to a light one." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="LightThemeToggle" Checked="PendingSetting_Changed" Unchecked="PendingSetting_Changed" />
        </ui:CardControl>

        <TextBlock Text="Preview" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,8" />
        <Border x:Name="PreviewSurface" CornerRadius="8" Padding="20" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="PreviewText" Text="This is what Lingstrap will look like." FontWeight="SemiBold" Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PreviewButton" CornerRadius="4" Padding="16,8" Margin="0,0,14,0">
                        <TextBlock Text="Sample button" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="PreviewToggleTrack" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Right" Margin="0,0,3,0" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <ui:Button x:Name="ApplyButton" Content="Apply and restart" Appearance="Primary" Margin="0,0,0,20"
                   HorizontalAlignment="Left" IsEnabled="False" Click="Apply_Click" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="UI scale" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="450"
                               Text="Makes the whole app bigger or smaller. Applies instantly." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="FontScaleCombo" Width="120" SelectionChanged="FontScaleCombo_SelectionChanged">
                <ComboBoxItem Content="80%" Tag="80" />
                <ComboBoxItem Content="90%" Tag="90" />
                <ComboBoxItem Content="100%" Tag="100" />
                <ComboBoxItem Content="110%" Tag="110" />
                <ComboBoxItem Content="125%" Tag="125" />
                <ComboBoxItem Content="150%" Tag="150" />
            </ComboBox>
        </ui:CardControl>
    </StackPanel>
</Page>

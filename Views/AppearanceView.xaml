<Page x:Class="Lingstrap.Views.AppearanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Appearance">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource HeaderIcon}" />
            <TextBlock Text="Appearance" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Sub}" Text="Pick an accent color for the app." />

        <WrapPanel x:Name="SwatchPanel" Margin="0,20,0,0" />
    </StackPanel>
</Page>

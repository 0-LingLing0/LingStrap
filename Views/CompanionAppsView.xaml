<Page x:Class="Lingstrap.Views.CompanionAppsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:v="clr-namespace:Lingstrap.Views"
      Title="Companion Apps"
      AllowDrop="True" DragEnter="Page_DragEnter" Drop="Page_Drop">
    <StackPanel Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
        <!-- Two real columns, not one cell with the button aligned right: sharing a cell lets the
             wrapping subtitle run underneath the button instead of stopping short of it. -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="AppsListDetail24" Style="{StaticResource HeaderIcon}" />
                    <TextBlock Text="Companion Apps" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}"
                           Text="Programs you only want running alongside Roblox - started after it launches, closed when it does." />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Add app" Icon="{ui:SymbolIcon Add24}" Click="AddApp_Click"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Style="{StaticResource SettingsGroup}">
            <v:SettingRow Title="Manage these apps with Roblox" ShowDivider="False"
                          Description="Off disables the whole feature without deleting the list below.">
                <ui:ToggleSwitch x:Name="ManageToggle" Checked="ManageToggle_Changed" Unchecked="ManageToggle_Changed" />
            </v:SettingRow>
        </Border>

        <StackPanel x:Name="RowsPanel" />

        <Border x:Name="EmptyState" BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CornerRadius="8" Padding="24" Margin="0,0,0,4">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="28" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock Text="No companion apps yet" Style="{StaticResource Body}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="Add one above, or drag a shortcut or .exe onto this page." Style="{StaticResource Sub}"
                           HorizontalAlignment="Center" Margin="0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="DropHint" Text="Drag a shortcut or .exe onto this page to add another"
                   Style="{StaticResource Sub}" Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>
</Page>

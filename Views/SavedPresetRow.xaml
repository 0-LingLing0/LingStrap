<UserControl x:Class="Lingstrap.Views.SavedPresetRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:CardControl Margin="0,0,0,8">
        <ui:CardControl.Header>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="SubText" Style="{StaticResource Sub}" Margin="0,2,0,0" />
            </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="ApplyButton" Content="Apply" Margin="0,0,6,0" Click="Apply_Click" />
            <ui:Button x:Name="RenameButton" Content="Rename" Margin="0,0,6,0" Click="Rename_Click" />
            <ui:Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
        </StackPanel>
    </ui:CardControl>
</UserControl>
